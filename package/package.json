{
  "name": "@vansah/vansah-connect",
  "version": "2.0.0",
  "description": "A Single Solution for all the CI/CD tools to send Test results to Vansah Test Management for Jira",
  "main": "bin/index.js",
  "files": [
    "bin/index.js",
    "api/sendresults.js",
    "const.js",
    "utility/displayOutput.js",
    "utility/env.js",
    "utility/validation.js"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 ../test/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 ../test/*.test.mjs",
    "test:functional": "node --test ../test/new-functionality.test.mjs",
    "test:regression": "node --test ../test/regression.test.mjs"
  },
  "author": "Vansah",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.18.0",
    "chalk": "2.4",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.6",
    "ora": "^7.0.1",
    "yargs": "13.2"
  },
  "bin": {
    "vansah-connect": "bin/index.js"
  },
  "devDependencies": {
    "chai": "^4.3.8",
    "esm": "^3.2.25",
    "mocha": "^10.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testpointcorp/vansah-connect.git"
  },
  "keywords": [
    "vansah",
    "test-management",
    "test-run",
    "test-execution",
    "test-result-upload",
    "testNG"
  ],
  "bugs": {
    "url": "https://github.com/testpointcorp/vansah-connect/issues"
  },
  "homepage": "https://github.com/testpointcorp/vansah-connect#readme"
}
