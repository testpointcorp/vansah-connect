# Copy to .env in the repository root and fill in your credentials.
# These targets match the current NEW2 test dataset. For another workspace,
# update the values below and the case/issue references in both report files.
# Setup instructions: test/TESTING-GUIDE.md

VANSAH_TOKEN=
VANSAH_URL=https://prodsgp.vansah.com
VANSAH_PROJECT_KEY=NEW2
VANSAH_MODE=stp

# Existing case, issue, folder, and plans used by the live tests.
VANSAH_TEST_CASE_KEY=NEW2-C2
VANSAH_JIRA_ISSUE_KEY=NEW2-1
VANSAH_FOLDER_PATH="cucumber import testing/"
VANSAH_STP_KEY=NEW2-P3
VANSAH_ATP_KEY=NEW2-P4
# Used by Cucumber uploads and single results; must exist in both plans.
VANSAH_ITERATION=3

VANSAH_ENVIRONMENT_NAME=SYS
VANSAH_SPRINT_NAME="NEW2 Sprint 1"
VANSAH_RELEASE_NAME=cucumber-itr

# Existing report files; relative paths resolve from the repository root.
VANSAH_CUCUMBER_REPORT=./test/fixtures/cucumber.json
VANSAH_TESTNG_REPORT=./test/fixtures/testng-report.xml
